    <div className="mgn-card" style={{ display: "flex", flexDirection: "column" }}>
      <div style={{ position: "relative" }}>
        <Cover book={book} />
        <button
          onClick={onFavorite}
          title={isFav ? "Remove from shelf" : "Add to shelf"}
          style={{ position: "absolute", top: 8, right: 8, background: "rgba(251,247,237,.9)", border: "1px solid #C9AE86", width: 28, height: 28, cursor: "pointer", fontSize: 14 }}
        >
          {isFav ? "\u2605" : "\u2606"}
        </button>
      </div>
      <div style={{ padding: "12px 14px 14px", display: "flex", flexDirection: "column", gap: 6, flex: 1 }}>
        {reason && <div className="mgn-stamp" style={{ alignSelf: "flex-start", fontSize: 9.5 }}>Recommended</div>}
        <div className="mono" style={{ fontSize: 10, color: "#9C8B63" }}>{book.call}</div>
        <h3 className="disp" style={{ fontSize: 15.5, margin: 0, lineHeight: 1.3 }}>{book.title}</h3>
        <div style={{ fontSize: 12.5, color: "#5C4A2E" }}>{book.author}</div>
        <Stars rating={book.rating} />
        {progress > 0 && (
          <div style={{ marginTop: 2 }}>
            <div className="mgn-progress-track"><div className="mgn-progress-fill" style={{ width: `${progress}%` }} /></div>
            <div className="mono" style={{ fontSize: 9.5, color: "#9C8B63", marginTop: 3 }}>{progress >= 100 ? "Finished" : `${progress}% read`}</div>
          </div>
        )}
        <button className="mgn-btn" style={{ marginTop: "auto", alignSelf: "flex-start" }} onClick={onRead}>
          {progress >= 100 ? "Read Again" : progress > 0 ? "Continue Reading" : "Read"}
        </button>
      </div>
    </div>
  );
}

/* ------------------------------------------------------------------ */
/*  MAIN APP                                                           */
/* ------------------------------------------------------------------ */

function App() {
  const [users, setUsers] = useState(() =>
    loadFromStorage("marginalia_users", [
      { id: "demo", name: "Demo Reader", email: "demo@marginalia.edu", password: "demo123" },
    ])
  );
  const [library, setLibrary] = useState(() =>
    loadFromStorage("marginalia_library", { demo: { finished: [], progress: {}, favorites: [] } })
  );
  const [currentUserId, setCurrentUserId] = useState(() => loadFromStorage("marginalia_session", null));
  const [view, setView] = useState("catalog");

  useEffect(() => saveToStorage("marginalia_users", users), [users]);
  useEffect(() => saveToStorage("marginalia_library", library), [library]);
  useEffect(() => saveToStorage("marginalia_session", currentUserId), [currentUserId]);
  const [activeBookId, setActiveBookId] = useState(null);
  const [search, setSearch] = useState("");
  const [genreFilter, setGenreFilter] = useState("All");
  const [sortBy, setSortBy] = useState("title");

  const currentUser = users.find((u) => u.id === currentUserId);
  const userLib = library[currentUserId] || { finished: [], progress: {}, favorites: [] };

  function handleLogin(id) { setCurrentUserId(id); setView("catalog"); }

  function handleSignup({ name, email, password }) {
    const id = "u" + Date.now();
    setUsers((prev) => [...prev, { id, name, email, password }]);
    setLibrary((prev) => ({ ...prev, [id]: { finished: [], progress: {}, favorites: [] } }));
    setCurrentUserId(id);
    setView("catalog");
  }

  function handleLogout() { setCurrentUserId(null); setActiveBookId(null); setView("catalog"); }

  function updateUserLib(fn) {
    setLibrary((prev) => ({ ...prev, [currentUserId]: fn(prev[currentUserId] || { finished: [], progress: {}, favorites: [] }) }));
  }

  function toggleFavorite(bookId) {
    updateUserLib((lib) => {
      const has = lib.favorites.includes(bookId);
      return { ...lib, favorites: has ? lib.favorites.filter((x) => x !== bookId) : [...lib.favorites, bookId] };
    });
  }

  function advanceProgress(bookId) {
    updateUserLib((lib) => {
      const cur = lib.progress[bookId] || 0;
      const next = Math.min(100, cur + 25);
      const newProgress = { ...lib.progress, [bookId]: next };
      let finished = lib.finished;
      if (next >= 100 && !finished.includes(bookId)) finished = [...finished, bookId];
      return { ...lib, progress: newProgress, finished };
    });
  }

  const recs = useMemo(() => computeRecommendations(userLib, BOOKS), [userLib]);

  const filtered = useMemo(() => {
    let list = BOOKS.filter((b) => {
      const matchesSearch = (b.title + " " + b.author).toLowerCase().includes(search.toLowerCase());
      const matchesGenre = genreFilter === "All" || b.genre === genreFilter;
      return matchesSearch && matchesGenre;
    });
    if (sortBy === "title") list = [...list].sort((a, b) => a.title.localeCompare(b.title));
    if (sortBy === "rating") list = [...list].sort((a, b) => b.rating - a.rating);
    if (sortBy === "newest") list = [...list].sort((a, b) => b.year - a.year);
    return list;
  }, [search, genreFilter, sortBy]);

  const readingNow = BOOKS.filter((b) => {
    const p = userLib.progress[b.id];
    return p > 0 && p < 100;
  });
  const finishedBooks = BOOKS.filter((b) => userLib.finished.includes(b.id));
  const favoriteBooks = BOOKS.filter((b) => userLib.favorites.includes(b.id));

  const genreCounts = {};
  finishedBooks.forEach((b) => (genreCounts[b.genre] = (genreCounts[b.genre] || 0) + 1));
  const favoriteGenre = Object.entries(genreCounts).sort((a, b) => b[1] - a[1])[0];

  if (!currentUser) {
    return <div className="mgn"><AuthScreen users={users} onLogin={handleLogin} onSignup={handleSignup} /></div>;
  }

  const activeBook = BOOKS.find((b) => b.id === activeBookId);

  const NAV_ITEMS = [
    ["catalog", "Catalog"],
    ["foryou", "For You"],
    ["reading", "Currently Reading"],
    ["profile", "Profile"],
  ];

  return (
    <div className="mgn">
      <div className="mgn-nav" style={{ position: "sticky", top: 0, zIndex: 30 }}>
        <div style={{ maxWidth: 1100, margin: "0 auto", padding: "14px 20px", display: "flex", justifyContent: "space-between", alignItems: "center", flexWrap: "wrap", gap: 10 }}>
          <div className="disp" style={{ fontSize: 20, fontWeight: 600 }}>Marginalia</div>
          <div style={{ display: "flex", gap: 4, flexWrap: "wrap" }}>
            {NAV_ITEMS.map(([key, label]) => (
              <button key={key} onClick={() => setView(key)} className={"mgn-navlink" + (view === key ? " active" : "")}>{label}</button>
            ))}
          </div>
          <div style={{ display: "flex", alignItems: "center", gap: 12 }}>
            <span className="mono" style={{ fontSize: 11, color: "#CBD8CC" }}>{currentUser.name}</span>
            <button className="mgn-btn ghost" style={{ color: "#FBF7ED", borderColor: "#FBF7ED" }} onClick={handleLogout}>Sign Out</button>
          </div>
        </div>
      </div>

      <div style={{ maxWidth: 1100, margin: "0 auto", padding: "28px 20px 60px" }}>

        {view === "catalog" && (
          <>
            <h1 className="disp" style={{ fontSize: 28, marginBottom: 4 }}>The Catalog</h1>
            <p className="mono" style={{ fontSize: 11.5, color: "#7A6A3E", marginBottom: 20 }}>{filtered.length} of {BOOKS.length} titles</p>

            <div style={{ display: "flex", gap: 12, flexWrap: "wrap", marginBottom: 16 }}>
              <input className="mgn-input" style={{ maxWidth: 280 }} placeholder="Search title or author\u2026" value={search} onChange={(e) => setSearch(e.target.value)} />
              <select className="mgn-input" style={{ maxWidth: 180 }} value={sortBy} onChange={(e) => setSortBy(e.target.value)}>
                <option value="title">Sort: Title</option>
                <option value="rating">Sort: Rating</option>
                <option value="newest">Sort: Newest</option>
              </select>
            </div>

            <div style={{ display: "flex", gap: 6, flexWrap: "wrap", marginBottom: 24 }}>
              <button className={"mgn-chip" + (genreFilter === "All" ? " active" : "")} onClick={() => setGenreFilter("All")}>All</button>
              {GENRES.map((g) => (
                <button key={g} className={"mgn-chip" + (genreFilter === g ? " active" : "")} onClick={() => setGenreFilter(g)}>{g}</button>
              ))}
            </div>

            <div style={{ display: "grid", gridTemplateColumns: "repeat(auto-fill, minmax(190px, 1fr))", gap: 16 }}>
              {filtered.map((b) => (
                <BookCard key={b.id} book={b} onRead={() => setActiveBookId(b.id)} onFavorite={() => toggleFavorite(b.id)}
                  isFav={userLib.favorites.includes(b.id)} progress={userLib.progress[b.id] || 0} />
              ))}
              {filtered.length === 0 && <p style={{ color: "#7A6A3E" }}>No titles match that search. Try a different word or clear the genre filter.</p>}
            </div>
          </>
        )}

        {view === "foryou" && (
          <>
            <h1 className="disp" style={{ fontSize: 28, marginBottom: 4 }}>For You</h1>
            <p style={{ fontSize: 14, color: "#5C4A2E", marginBottom: 24, maxWidth: 560 }}>
              {recs.reason === "staff"
                ? "You haven't read anything yet, so here are the catalog's highest-rated titles across every shelf."
                : `Built from what's on your shelf — you gravitate toward ${recs.reason}, so the engine weighted these higher.`}
            </p>
            <div style={{ display: "grid", gridTemplateColumns: "repeat(auto-fill, minmax(190px, 1fr))", gap: 16 }}>
              {recs.picks.map((b) => (
                <BookCard key={b.id} book={b} onRead={() => setActiveBookId(b.id)} onFavorite={() => toggleFavorite(b.id)}
                  isFav={userLib.favorites.includes(b.id)} progress={userLib.progress[b.id] || 0} reason />
              ))}
            </div>
          </>
        )}

        {view === "reading" && (
          <>
            <h1 className="disp" style={{ fontSize: 28, marginBottom: 20 }}>Currently Reading</h1>
            {readingNow.length === 0 ? (
              <p style={{ color: "#7A6A3E" }}>Nothing in progress. Open a book from the Catalog to start a chapter.</p>
            ) : (
              <div style={{ display: "grid", gridTemplateColumns: "repeat(auto-fill, minmax(190px, 1fr))", gap: 16 }}>
                {readingNow.map((b) => (
                  <BookCard key={b.id} book={b} onRead={() => setActiveBookId(b.id)} onFavorite={() => toggleFavorite(b.id)}
                    isFav={userLib.favorites.includes(b.id)} progress={userLib.progress[b.id] || 0} />
                ))}
              </div>
            )}
          </>
        )}

        {view === "profile" && (
          <>
            <h1 className="disp" style={{ fontSize: 28, marginBottom: 20 }}>Your Membership Card</h1>
            <div className="mgn-card" style={{ padding: 24, marginBottom: 28, maxWidth: 480 }}>
              <div className="mono" style={{ fontSize: 10.5, color: "#9C8B63" }}>MEMBER</div>
              <div className="disp" style={{ fontSize: 20, margin: "4px 0 14px" }}>{currentUser.name}</div>
              <div style={{ display: "grid", gridTemplateColumns: "1fr 1fr 1fr", gap: 14 }}>
                <div><div className="disp" style={{ fontSize: 22 }}>{finishedBooks.length}</div><div className="mono" style={{ fontSize: 10, color: "#7A6A3E" }}>FINISHED</div></div>
                <div><div className="disp" style={{ fontSize: 22 }}>{readingNow.length}</div><div className="mono" style={{ fontSize: 10, color: "#7A6A3E" }}>IN PROGRESS</div></div>
                <div><div className="disp" style={{ fontSize: 22 }}>{favoriteBooks.length}</div><div className="mono" style={{ fontSize: 10, color: "#7A6A3E" }}>ON SHELF</div></div>
              </div>
              {favoriteGenre && (
                <div style={{ marginTop: 16 }}><span className="mgn-stamp">Favors {favoriteGenre[0]}</span></div>
              )}
            </div>

            <h2 className="disp" style={{ fontSize: 19, marginBottom: 12 }}>Your Shelf</h2>
            {favoriteBooks.length === 0 ? (
              <p style={{ color: "#7A6A3E" }}>Add books to your shelf from the Catalog or a reading view.</p>
            ) : (
              <div style={{ display: "grid", gridTemplateColumns: "repeat(auto-fill, minmax(190px, 1fr))", gap: 16 }}>
                {favoriteBooks.map((b) => (
                  <BookCard key={b.id} book={b} onRead={() => setActiveBookId(b.id)} onFavorite={() => toggleFavorite(b.id)}
                    isFav={true} progress={userLib.progress[b.id] || 0} />
                ))}
              </div>
            )}
          </>
        )}
      </div>

      {activeBook && (
        <ReadingView
          book={activeBook}
          progress={userLib.progress[activeBook.id] || 0}
          onAdvance={() => advanceProgress(activeBook.id)}
          onClose={() => setActiveBookId(null)}
          onFavorite={() => toggleFavorite(activeBook.id)}
          isFav={userLib.favorites.includes(activeBook.id)}
        />
      )}
    </div>
  );
}


const root = ReactDOM.createRoot(document.getElementById("root"));
root.render(<App />);
</script>
</body>
</html>
