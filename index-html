      onLogin(u.id);
    } else {
      if (!name.trim() || !email.trim() || password.length < 4) {
        return setError("Please fill in your name, email, and a password of at least 4 characters.");
      }
      if (users.some((x) => x.email.toLowerCase() === email.trim().toLowerCase())) {
        return setError("An account with that email already exists — try logging in instead.");
      }
      onSignup({ name: name.trim(), email: email.trim(), password });
    }
  }

  return (
    <div className="mgn" style={{ minHeight: "100vh", display: "flex", alignItems: "center", justifyContent: "center", padding: 20 }}>
