/* ------------------------------------------------------------------ */
/*  RECOMMENDATION ENGINE (content-based filtering)                    */
/* ------------------------------------------------------------------ */

function computeRecommendations(userLib, books) {
  const weights = {};
  const touched = new Set();
  (userLib.finished || []).forEach((id) => {
    const b = books.find((x) => x.id === id);
    if (b) { weights[b.genre] = (weights[b.genre] || 0) + 3; touched.add(id); }
  });
  Object.keys(userLib.progress || {}).forEach((id) => {
    const b = books.find((x) => x.id === id);
    if (b) { weights[b.genre] = (weights[b.genre] || 0) + 2; touched.add(id); }
  });
  (userLib.favorites || []).forEach((id) => {
    const b = books.find((x) => x.id === id);
    if (b) { weights[b.genre] = (weights[b.genre] || 0) + 1.5; touched.add(id); }
  });

  const candidates = books.filter((b) => !touched.has(b.id));

  if (Object.keys(weights).length === 0) {
    return {
      picks: [...candidates].sort((a, b) => b.rating - a.rating).slice(0, 6),
      reason: "staff",
    };
  }

  const topGenre = Object.entries(weights).sort((a, b) => b[1] - a[1])[0][0];
  const scored = candidates.map((b) => ({
    book: b,
    score: (weights[b.genre] || 0) + b.rating / 10,
  }));
  scored.sort((a, b) => b.score - a.score);
  return {
    picks: scored.slice(0, 6).map((s) => s.book),
    reason: topGenre,
  };
}

