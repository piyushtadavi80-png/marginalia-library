function ReadingView({ book, progress, onAdvance, onClose, onFavorite, isFav }) {
  const chapter = Math.min(Math.floor(progress / 25), 3);
  const finished = progress >= 100;

  return (
    <div style={{ position: "fixed", inset: 0, background: "rgba(30,24,16,.55)", display: "flex", alignItems: "center", justifyContent: "center", padding: 18, zIndex: 50 }}>
      <div className="mgn-card mgn-scroll" style={{ width: "100%", maxWidth: 680, maxHeight: "88vh", overflowY: "auto", padding: 0 }}>
        <div style={{ background: GENRE_STYLE[book.genre].color, color: "#F1E9D6", padding: "22px 28px", display: "flex", justifyContent: "space-between", alignItems: "flex-start" }}>
          <div>
            <div className="mono" style={{ fontSize: 10.5, letterSpacing: ".08em", opacity: .8 }}>{book.call}</div>
            <h2 className="disp" style={{ margin: "6px 0 4px", fontSize: 24 }}>{book.title}</h2>
            <div style={{ fontSize: 13.5, opacity: .85 }}>by {book.author} &middot; {book.genre} &middot; {book.year}</div>
          </div>
          <button onClick={onClose} className="mono" style={{ background: "none", border: "none", color: "#F1E9D6", fontSize: 20, cursor: "pointer", lineHeight: 1 }}>&times;</button>
        </div>

        <div style={{ padding: "26px 28px" }}>
          <div style={{ display: "flex", justifyContent: "space-between", alignItems: "center", marginBottom: 6 }}>
            <span className="mono" style={{ fontSize: 11, color: "#7A6A3E" }}>
              {finished ? "FINISHED" : `CHAPTER ${chapter + 1} OF 4`}
            </span>
            <span className="mono" style={{ fontSize: 11, color: "#7A6A3E" }}>{progress}%</span>
          </div>
          <div className="mgn-progress-track"><div className="mgn-progress-fill" style={{ width: `${progress}%` }} /></div>

          <p style={{ marginTop: 22, fontSize: 16.5, lineHeight: 1.85, color: "#2B2118" }}>
            {chapterText(book, chapter)}
          </p>

          {finished && (
            <div className="mgn-stamp" style={{ marginTop: 14 }}>Shelved &middot; Read Complete</div>
          )}

          <div style={{ display: "flex", gap: 10, marginTop: 26, flexWrap: "wrap" }}>
            {!finished && (
              <button className="mgn-btn brass" onClick={onAdvance}>
                {chapter < 3 ? "Read Next Chapter \u2192" : "Finish Book"}
              </button>
            )}
            <button className="mgn-btn ghost" onClick={onFavorite}>
              {isFav ? "\u2605 On Your Shelf" : "\u2606 Add to Shelf"}
            </button>
            <button className="mgn-btn ghost" onClick={onClose}>Close</button>
          </div>
        </div>
      </div>
    </div>
  );
}

