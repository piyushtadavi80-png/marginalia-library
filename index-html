/* ------------------------------------------------------------------ */
/*  LOCAL STORAGE PERSISTENCE                                          */
/*  Keeps signups, logins, shelves, and reading progress saved in the  */
/*  browser so they survive a page refresh. Passwords are stored in    */
/*  plain text here for simplicity — fine for a class project demo,    */
/*  but never do this in a real production app.                       */
/* ------------------------------------------------------------------ */

function loadFromStorage(key, fallback) {
  try {
    const raw = window.localStorage.getItem(key);
    return raw ? JSON.parse(raw) : fallback;
  } catch {
    return fallback;
  }
}

function saveToStorage(key, value) {
  try {
    window.localStorage.setItem(key, JSON.stringify(value));
  } catch {
    // localStorage can fail (private browsing, storage full, etc.) —
    // the app still works, it just won't persist between visits.
  }
}

